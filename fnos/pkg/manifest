appname               = xerp
version               = 1.0.6
display_name          = x.erp
desc                  = 轻量级企业资源计划（ERP）系统：商品与库存、销售、采购、客户/供应商往来、财务收支、人事与经营报表，多账号权限与操作日志，数据保存在 NAS 本地并每日自动备份。
platform              = all
source                = thirdparty
maintainer            = x.erp
distributor           = x.erp
install_dep_apps      = nodejs_v22
service_port          = 8686
checkport             = true
ctl_stop              = true
desktop_uidir         = ui
desktop_applaunchname = xerp.Application
changelog             = 新增多单位：商品可设辅助单位（如 1 箱 = 12 个），开单可按箱录入，库存仍按基本单位核算，箱条码扫码自动选箱。新增打印模板：入库单、出库单、调拨单、销售单、采购单可自定义标题（如改成送货单）、抬头地址电话、表头项目、明细列的显示顺序和名称、签字栏、底部说明和字号。销售 / 采购单改为按模板打印；已收付款的订单修改后合计不能少于已收付金额。
