appname               = xerp
version               = 2.15.0
display_name          = x.erp
desc                  = 轻量级企业资源计划（ERP）系统：商品与库存、销售、采购、客户/供应商往来、财务收支、人事与经营报表，多账号权限与操作日志，数据保存在 NAS 本地并每日自动备份。
platform              = all
source                = thirdparty
maintainer            = x.erp
distributor           = x.erp
install_dep_apps      = nodejs_v22
service_port          = 8686
checkport             = true
ctl_stop              = true
desktop_uidir         = ui
desktop_applaunchname = xerp.Application
changelog             = 打印模板支持 Logo 位置调整（默认与标题同排）、二等分纸自定义宽度（默认 215mm）及费用报销单模板与 24px 大字号；销售单与直接出库默认带出销售价，采购单支持 4 位小数单价并按优惠分摊净单价精确入库；库存成本价权限与销售价权限拆分，业务员看不到成本但可按销售价开单；备用金代领同步到领用人个人账号，人事员工绑定登录账号并自动带出部门；新增发票管理、粮食过磅收购、业务员客户与报表隔离、人事联动开号、退货审核自动生成仓库出入库单、订单超量容差与提前完结、待审/驳回出入库单修改与作废单据删除、条码标签日期与操作员、农资二维码解析及多图问题反馈
