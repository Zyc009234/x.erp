appname               = xerp
version               = 2.0.2
display_name          = x.erp
desc                  = 轻量级企业资源计划（ERP）系统：商品与库存、销售、采购、客户/供应商往来、财务收支、人事与经营报表，多账号权限与操作日志，数据保存在 NAS 本地并每日自动备份。
platform              = all
source                = thirdparty
maintainer            = x.erp
distributor           = x.erp
install_dep_apps      = nodejs_v22
service_port          = 8686
checkport             = true
ctl_stop              = true
desktop_uidir         = ui
desktop_applaunchname = xerp.Application
changelog             = 新增序列号管理（一件一个号，出入库 / 调拨逐件登记，可追溯每件去向）、往来对账单（按单位和期间列收发货明细与应收应付，可打印盖章）、库龄 / 呆滞品分析、库存提醒每日推送（企业微信 / 钉钉 / 飞书 / Webhook）。盘点支持按「2箱3」录入和扫码累加（安卓连续扫码），Excel 导入支持条码和辅助单位，标签可打箱条码，补货建议可按整件取整。
