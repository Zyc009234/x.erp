distributor           = x.erp
install_dep_apps      = nodejs_v22
service_port          = 8686
checkport             = true
ctl_stop              = true
desktop_uidir         = ui
desktop_applaunchname = xerp.Application
changelog             = 物流运费接入快递鸟：开出库单后可直接下电子面单，自动取快递单号并打印面单（支持取消、补打）；按快递单号查询物流轨迹，运单列表显示在途 / 签收 / 问题件，可一键刷新或白天每 4 小时自动刷新。系统设置里填快递鸟商户 ID、AppKey 和寄件人，快递报价里填快递鸟编码和网点给的电子面单账号。需要服务器能连外网。
