appname               = xerp
version               = 2.0.6
display_name          = x.erp
desc                  = 轻量级企业资源计划（ERP）系统：商品与库存、销售、采购、客户/供应商往来、财务收支、人事与经营报表，多账号权限与操作日志，数据保存在 NAS 本地并每日自动备份。
platform              = all
source                = thirdparty
maintainer            = x.erp
distributor           = x.erp
install_dep_apps      = nodejs_v22
service_port          = 8686
checkport             = true
ctl_stop              = true
desktop_uidir         = ui
desktop_applaunchname = xerp.Application
changelog             = 开单新增「选择商品」窗口：入库单、出库单、调拨单、销售 / 采购订单和退货单的明细上方都有，左边按分类筛选，上面可搜索编码 / 条码 / 名称 / 规格，显示库存和售价，可跨分类多选、全选，一次加进明细，已在单中的商品会标出来、再选数量 +1。原来的输入框和扫码照旧可用。修复调拨单扫码重复商品时数量会 +2。
