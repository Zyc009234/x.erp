install_dep_apps      = nodejs_v22
service_port          = 8686
checkport             = true
ctl_stop              = true
desktop_uidir         = ui
desktop_applaunchname = xerp.Application
changelog             = 新增专业版（可免费试用 15 天）：多仓库与调拨单（出入库、盘点、发货、采购入库按仓库，收发存可按仓库统计）；批次与保质期（入库记批号和有效期，出库先到期先出，过期批次不自动发出，临期提醒）；条码标签批量打印（热敏标签或 A4 不干胶）；补货建议（按出库速度、在途采购算补货量，按供应商一键生成采购单）。商品新增条码字段，扫码枪可按条码录入。
