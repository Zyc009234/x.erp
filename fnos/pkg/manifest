install_dep_apps      = nodejs_v22
service_port          = 8686
checkport             = true
ctl_stop              = true
desktop_uidir         = ui
desktop_applaunchname = xerp.Application
changelog             = 新增资金账户：可以建微信、支付宝、银行卡、现金等账户并填期初余额，订单收付款和记一笔都选账户，自动算出每个账户的当前余额；支持账户互转（取现、提现到银行卡，不算收支）；收支流水可以按账户筛选；老数据按原来的收付方式自动归到对应账户。
