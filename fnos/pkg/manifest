appname               = xerp
version               = 2.1.4
display_name          = x.erp
desc                  = 轻量级企业资源计划（ERP）系统：商品与库存、销售、采购、客户/供应商往来、财务收支、人事与经营报表，多账号权限与操作日志，数据保存在 NAS 本地并每日自动备份。
platform              = all
source                = thirdparty
maintainer            = x.erp
distributor           = x.erp
install_dep_apps      = nodejs_v22
service_port          = 8686
checkport             = true
ctl_stop              = true
desktop_uidir         = ui
desktop_applaunchname = xerp.Application
changelog             = 根据用户留言改进：1）新增「报销管理」：员工提交报销单（可附发票照片）→ 审批批准 / 驳回 → 财务付款，付款后按类别自动记支出、从资金账户扣，可撤销付款，按人按月统计，可打印报销单；2）出库单可以填「出库单价」（选填，实际卖价），单据金额、打印和往来对账按出库单价算，库存成本仍按加权成本。
