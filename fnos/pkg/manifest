appname               = xerp
version               = 2.0.5
display_name          = x.erp
desc                  = 轻量级企业资源计划（ERP）系统：商品与库存、销售、采购、客户/供应商往来、财务收支、人事与经营报表，多账号权限与操作日志，数据保存在 NAS 本地并每日自动备份。
platform              = all
source                = thirdparty
maintainer            = x.erp
distributor           = x.erp
install_dep_apps      = nodejs_v22
service_port          = 8686
checkport             = true
ctl_stop              = true
desktop_uidir         = ui
desktop_applaunchname = xerp.Application
changelog             = 销售订单、采购订单的商品明细改成和入库单一样：输入编码 / 条码 / 名称搜索，扫码枪扫完回车直接加一行，重复扫同一商品自动数量 +1。新增销售退货、采购退货：可关联原单自动带出可退数量和原单价（不能超退），销售退货按原发货成本入库、采购退货按原采购价出库；退款可走现金（记入财务），也可直接冲抵原单没结清的款；往来对账单把退货和退款算进应收应付。修复入库 / 出库单扫码重复商品时数量会 +2 的问题。
