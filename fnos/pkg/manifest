appname               = xerp
version               = 2.0.3
display_name          = x.erp
desc                  = 轻量级企业资源计划（ERP）系统：商品与库存、销售、采购、客户/供应商往来、财务收支、人事与经营报表，多账号权限与操作日志，数据保存在 NAS 本地并每日自动备份。
platform              = all
source                = thirdparty
maintainer            = x.erp
distributor           = x.erp
install_dep_apps      = nodejs_v22
service_port          = 8686
checkport             = true
ctl_stop              = true
desktop_uidir         = ui
desktop_applaunchname = xerp.Application
changelog             = 新增「物流运费」模块（在系统设置里启用）：维护各家快递按省份分区的报价（重量段或首重 + 续重，可导入 Excel 报价表）；开出库单时按收货地址自动识别省份、按商品重量估算各家运费；发货登记快递单号（支持扫码、多包裹、称重）；导入快递月结账单逐单对账，自动找出金额差异、漏登记、重复计费和漏账，并分析差异来自称重、省份还是没按报价收费，认可部分可记快递费支出，有争议的单子可申诉后再结算；运费统计按月、快递、省份汇总。商品档案新增重量和包装尺寸。
